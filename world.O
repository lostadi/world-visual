connection.execute("CREATE TABLE checkpoints(world INTEGER, checkpoint INTEGER, crc INTEGER)")
connection.executemany("INSERT INTO checkpoints VALUES(?,?,?)", rows)
score = connection.execute("SELECT SUM((world+1)*checkpoint*crc) FROM checkpoints").fetchone()[0]
