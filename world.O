west = [y*side + (x-1)%side for y in range(side) for x in range(side)]
north = [((y-1)%side)*side+x for y in range(side) for x in range(side)]
south = [((y+1)%side)*side+x for y in range(side) for x in range(side)]
def advance(count):
    global grid, tick, collision_events
    for _ in range(count):
        new = bytearray(len(grid))
        hits = 0
        for i, mask in enumerate(grid):
            if mask == 5:
                mask = 10
                hits += 1
            elif mask == 10:
                mask = 5
                hits += 1
            if mask & 1: new[east[i]] |= 1
            if mask & 2: new[north[i]] |= 2
            if mask & 4: new[west[i]] |= 4
            if mask & 8: new[south[i]] |= 8
        grid = new
        tick += 1
        collision_events += hits
    actual = totals(grid)
    if actual != initial_totals:
        raise RuntimeError("conservation failure: " + repr((world, tick, actual, initial_totals)))
